# =============================================================================
# Nginx Reverse Proxy Configuration: Febriyann Store
# Domain: store.febriyann.my.id
# Target: Next.js (port 3000) & Express API (port 5050)
#
# Production placement on Ubuntu/Debian:
#   /etc/nginx/sites-available/store.febriyann.my.id
# Symlink:
#   sudo ln -s /etc/nginx/sites-available/store.febriyann.my.id /etc/nginx/sites-enabled/
# =============================================================================

# 1. HTTP Server - Redirects all traffic to HTTPS (with Let's Encrypt challenge exception)
server {
    listen 80;
    listen [::]:80;
    server_name store.febriyann.my.id;

    # Let's Encrypt ACME HTTP challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Redirect all HTTP requests to HTTPS permanently
    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. HTTPS Server - Main Application Proxy
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name store.febriyann.my.id;

    # SSL Certificates (managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/store.febriyann.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/store.febriyann.my.id/privkey.pem;

    # SSL Protocols & Ciphers (Modern, High Security)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security Headers (OWASP Top 10 Hardening)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Global upload size limit
    client_max_body_size 2M;

    # -------------------------------------------------------------------------
    # Route: Public Health Check (Express Backend)
    # Direct pass to /health or /health/db without going through Next.js
    # -------------------------------------------------------------------------
    location ~ ^/health(/db)?$ {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off; # Keep access logs clean from periodic health checks
    }

    # -------------------------------------------------------------------------
    # Route: API v1 (Express Backend)
    # -------------------------------------------------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:5050/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable response buffering for API responses
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # -------------------------------------------------------------------------
    # Route: Frontend (Next.js Application)
    # -------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
