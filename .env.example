# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=store_dev
DB_CONNECTION_LIMIT=10
# At least 32 characters, random
SESSION_SECRET=
CORS_ORIGIN=http://localhost:3000
# Optional. Leave empty for host-only cookies
COOKIE_DOMAIN=
LOG_LEVEL=info
# Optional. Database used by tests; must end with _test (default: store_test)
# TEST_DB_NAME=store_test
